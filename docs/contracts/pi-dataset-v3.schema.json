    "ProductV3": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "patternProperties": {
            "^[a-z][A-Za-z0-9_]{1,62}$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Attributes",
