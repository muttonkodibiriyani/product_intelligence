        }
      },
      "required": [
        "id",
        "brand",
        "name",
        "category",
        "unit",
        "offers"
      ],
      "title": "ProductV3",
      "type": "object"
    },
    "ProfileInfo": {
      "additionalProperties": false,
      "description": "``meta.profile``: which profile version is in force, and its size rules (ADR-0008 §1).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,62}$",
          "title": "Name",
          "type": "string"
        },
        "sizeLabelsComparable": {
          "title": "Sizelabelscomparable",
          "type": "boolean"
        },
        "sizeSystemRequired": {
          "title": "Sizesystemrequired",
          "type": "boolean"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version",
        "sizeLabelsComparable",
        "sizeSystemRequired"
      ],
      "title": "ProfileInfo",
      "type": "object"
    },
    "Rating": {
      "additionalProperties": false,
      "description": "The retailer's published rating on its own ``scale`` (e.g. ``\"5\"`` for 0-5 stars).\n\nThe producer never rescales; consumers compare ratings only on the same scale or after\nnormalising ``average / scale`` themselves.",
      "properties": {
        "average": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Average",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "scale": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Scale",
          "type": "string"
        }
      },
      "required": [
        "average",
        "scale",
        "count"
      ],
      "title": "Rating",
      "type": "object"
    },
    "Retailer": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "title": "Country",
          "type": "string"
        },
        "earlyExamples": {
          "default": false,
          "title": "Earlyexamples",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{1,62}$",
          "title": "Id",
          "type": "string"
        },
        "logo": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "\\S",
                "type": "string"
              },
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "since": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Since"
        },
        "status": {
          "$ref": "#/$defs/RetailerStatus"
        }
      },
      "required": [
        "id",
        "name",
        "country",
        "status",
        "since",
        "note"
      ],
      "title": "Retailer",
      "type": "object"
    },
    "RetailerStatus": {
      "description": "Coverage of a retailer in this snapshot. Only ``supported`` backs an absence claim.",
      "enum": [
        "supported",
        "partial",
        "blocked",
        "pending",
        "retired"
      ],
      "title": "RetailerStatus",
      "type": "string"
    },
    "ReviewState": {
      "description": "Lifecycle of a match edge (MAT-05, MAT-07).",
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "locked"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "Series": {
      "additionalProperties": false,
      "description": "One entry per ``meta.dates``; ``null`` means not observed that day, never zero.\n\n``price`` is the selling price observed; ``regular`` is the retailer's stated regular (was)\nprice. There is no promo series: promotion depth is derived from the two by the metric layer,\nso the contract carries only what was observed.\n\nEvery price is positive (a zero or negative \"price\" is a parse failure, recorded in\n``meta.fields``, never a value). ``availability`` uses ``null`` for \"not observed that day\",\nlike the money series; the ``not_observed`` state is therefore not allowed in a series, so\nthere is one spelling.",
      "properties": {
        "availability": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/AvailabilityState"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability"
        },
        "price": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/MoneyValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Price",
          "type": "array"
        },
        "regular": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MoneyValue"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regular"
        }
      },
      "required": [
        "price"
      ],
      "title": "Series",
      "type": "object"
    },
    "SizeV3": {
      "additionalProperties": false,
      "description": "The size of the thing priced, as published: a measure, a label, or both. Never converted.\n\n``{\"value\": \"250\", \"unit\": \"ml\"}``, ``{\"label\": \"Medium\"}``, or a count such as\n``{\"value\": \"9\", \"unit\": \"pcs\", \"label\": \"9 pcs\"}``. ``system`` names the label's namespace\n(``alpha``, ``eu``, ``uk``, ``us``) where it matters.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "system": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "System"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "label",
        "system"
      ],
      "title": "SizeV3",
      "type": "object"
    }
  },
  "$id": "https://github.com/muttonkodibiriyani/product_intelligence/docs/contracts/pi-dataset-v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Published snapshot contract v3 (ADR-0008). Generated from pi_dataset; do not edit. Cross-field rules (context ids, identity rules, declared attributes, profile size rules, plus every v2 rule) are in docs/contracts/pi-dataset-v3.md and enforced by pi_dataset.load_any.",
  "properties": {
    "meta": {
      "$ref": "#/$defs/MetaV3"
    },
    "notObserved": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NotObservedV3"
      },
      "title": "Notobserved",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/ProductV3"
      },
      "minItems": 1,
      "title": "Products",
      "type": "array"
    },
    "schema": {
      "const": "pi.dataset/v3",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "meta",
    "products"
  ],
  "title": "pi.dataset/v3",
  "type": "object"
}
