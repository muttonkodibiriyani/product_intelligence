          "title": "Image"
        },
        "matches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MatchEdge"
          },
          "title": "Matches",
          "type": "array"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "offers": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]{1,62}$": {
              "$ref": "#/$defs/OfferV3"
