# pi-api's live Cloud Run settings, sourced by docs/runbooks/pi-api-deploy.md §6. The deploy
# builds --memory, --max-instances and PI_API_MEMORY_MIB from this file, and
# `infra/scripts/pi_api_admission.py service` STOPs unless the live service equals it.
# Step F's values (2026-10-07, Coordinator 01a117cd-f12e): the f3gi revision serves Ounass on the
# image before this file existed, at limits.memory "3Gi", revision autoscaling.knative.dev/maxScale
# "1" and service-level run.googleapis.com/maxScale "1" (was 1Gi, 3 and 20). This file lands after
# that revision is live; if it is not, `service` STOPs on these three lines, which is correct.
# Measured at 3072 on the live set: infra/pi-api/admission/ounass_ae.json.
PI_API_PROJECT=productintelligence-beeb3
PI_API_REGION=me-central1
PI_API_MEMORY_MIB=3072
PI_API_MAX_SCALE_REVISION=1
PI_API_MAX_SCALE_SERVICE=1
