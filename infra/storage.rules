rules_version = '2';
// Deployed to productintelligence-beeb3 and used by the local emulator.
// Clients never write. Signed-in users with an invited role (custom claim set by
// infra/scripts/invite_user.py) may read published datasets; everything else is denied.
// Server-side jobs use admin credentials, which bypass rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /datasets/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'viewer'];
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
