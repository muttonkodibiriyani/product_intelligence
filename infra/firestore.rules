rules_version = '2';
// Deployed to productintelligence-beeb3 and used by the local emulator.
// Clients never write. Signed-in users with an invited role (custom claim set by
// infra/scripts/invite_user.py) may read the demo_* collections; everything else is denied.
// Server-side jobs use admin credentials, which bypass rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isInvited() {
      return request.auth != null && request.auth.token.role in ['admin', 'viewer'];
    }

    match /{collection}/{document=**} {
      allow read: if isInvited() && collection.matches('demo_.*');
      allow write: if false;
    }
  }
}
