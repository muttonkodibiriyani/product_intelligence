rules_version = '2';
// Deployed to productintelligence-beeb3 and used by the local emulator.
// Clients never write, with one exception below. Signed-in users with an invited role (custom
// claim set by infra/scripts/invite_user.py) may read the demo_* collections; everything else is
// denied. Server-side jobs use admin credentials, which bypass rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isInvited() {
      return request.auth != null && request.auth.token.role in ['admin', 'viewer'];
    }

    // The budget-alert kill switch (docs/design/ai-assistant.md §9.4) signs in as a password
    // account whose role claim is 'killswitch'. It can only turn the assistant OFF: update the
    // existing assistant_config/current, changing nothing but `enabled` (to false) and
    // `disabledBy`. It cannot read, create, delete or touch any other document.
    function isKillSwitch() {
      return request.auth != null
        && request.auth.token.role == 'killswitch'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /assistant_config/current {
      allow update: if isKillSwitch()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'disabledBy'])
        && request.resource.data.enabled == false
        && request.resource.data.disabledBy is string
        && request.resource.data.disabledBy.matches('budget_alert:[0-9]{1,3}%:[0-9]{4}-[0-9]{2}');
    }

    match /{collection}/{document=**} {
      allow read: if isInvited() && collection.matches('demo_.*');
      allow write: if false;
    }
  }
}
