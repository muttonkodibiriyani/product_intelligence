rules_version = '2';
// Deny-all baseline. Firestore holds app state only (ADR-0002); real rules arrive with the
// web app (PR17). These rules are used by the local emulator only — never deployed from here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
