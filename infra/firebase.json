{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web-dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pi-api",
          "region": "me-central1"
        }
      },
      {
        "source": "/app/**",
        "destination": "/app/404.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-1h8tmEw10p1AxocxrbHdleOsqrv9Ny5w22yfAe8NBZY=' 'sha256-5x001aUHEobD9cN5squ9pb8X0XNLaLpUUQPFW2Pw/sU=' 'sha256-8MO/8md0Qy2Lrjl0/19lKNrQTr+2kkuyIlC9d8DQ0AA=' 'sha256-ByoOEgBWhn1l69g/vXi9E7End193uA/fUxIp4mqYyUo=' 'sha256-GR7RmuaJIMtx6HDOvic0edD2k198tEA9zkDq8s6FsHQ=' 'sha256-HOZayzBGpiLZjdMI2mWKJdu1CnfvheNZ0YfW5QvuVhU=' 'sha256-KQRdk9qyJahd9jEklDuPlSD61Anvhef+vqDoZuvTKb0=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-Si8BP6c80yNwqXAY704Q86XMPKx/cIK6piewV38cJ6Y=' 'sha256-efPOclzqZo6yjXVbGc6DvUZBw2j/G7IWPJvn4Iwdt/s=' 'sha256-jdZn9pbx696uTtKXWcZ63ELPytpn4iu148nQtwL/8eA='; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
          }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 59099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 58080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 59199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 54400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 54500
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 54000
    },
    "singleProjectMode": true
  }
}
