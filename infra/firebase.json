{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web-dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pi-api",
          "region": "me-central1"
        }
      },
      {
        "source": "/app/**",
        "destination": "/app/404.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-9udYOh+2lZFZVhMsS1IGx1FTp6vaF9vUQQNzolcApCQ=' 'sha256-DflxZ0MUVkPJFKYlbNulpIZYjxzgMU5LQZeHPNFZUao=' 'sha256-GEcVcgyyIywAigk+gtHo375XLbZcaOMcjRsT4ojBGuA=' 'sha256-HlRDBoyULVy8zFW6AEJG7kJ7joGKCV2zGdInOK/x+uo=' 'sha256-Koioemkc4CvDhGluXrZrMYamd41UMWfB0ds6HHo+cqQ=' 'sha256-LogqIZ1g1VUlgfPv6APY91+kKHHcXPlH0FZWNeBWrks=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-jx1q5cEqKuW37Hb/yoVC2U4zuaS2ZJ+Wj8yNrnc7AMs=' 'sha256-lC59jWmRRNxUkwHZvu9VILBYwkmYAfclocJFS7SPvU8=' 'sha256-mJDKO6aAA67FPYyInY1aVhqa8I1Z9CU4/UhssRcUkmU=' 'sha256-qX0mtw68exWbpSxufC5PWP8TtZcLQZqzNJ7GNVWXQsw='; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
          }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 59099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 58080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 59199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 54400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 54500
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 54000
    },
    "singleProjectMode": true
  }
}
