{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web-dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pi-api",
          "region": "me-central1"
        }
      },
      {
        "source": "/app/**",
        "destination": "/app/404.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-BJg7iJC+sk9yXpOWjli39LEm/C0BKJ0mOxlV3jp266Y=' 'sha256-J1fBm4lbPIovYzX1CiqUZomc/wYQ61Ka29MiFOpgX4Y=' 'sha256-KnVhKfZESGn8ToHmMTml5NTz6TZ+ni7XkQD4IkO3nGs=' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-OcA/xDz6mm9UMHxPpHi9h3/ZjCdK7s14Cvbmb8dFVlg=' 'sha256-R28OOaTVnHMh4vv/Cv0wdY2IAlSBMxMwFX8kd65VVe0=' 'sha256-kaDU7m72KLqsC3INfK6CeIv20F0sa+pf0N4Y/KMZroo=' 'sha256-n4IHSjJ/kLfqHZXJdTjQcjB06HUq9c52Rcip4gNOXuA=' 'sha256-uDjBk3ZlBBTIKxMqpxNnRetgbF1npd/1CmA1qXXgRCA=' 'sha256-uY/V+4DM+Y8YUNKulXXfoutfmp9wBpRnuX2MNeBC+0I=' 'sha256-v/ZmzKNhTYMf9AgFI7bfkd8KbJK+pv81T/Mxo3ta1aw='; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
          }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 59099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 58080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 59199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 54400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 54500
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 54000
    },
    "singleProjectMode": true
  }
}
