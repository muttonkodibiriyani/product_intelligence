{
  "name": "@pi/web",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:assistant && next build && node scripts/check-bundle.mjs out && node scripts/csp.mjs --check out out-assistant",
    "build:assistant": "rm -rf out-assistant && NEXT_PUBLIC_ASSISTANT_ENABLED=true next build && node scripts/check-bundle.mjs out && mv out out-assistant",
    "csp:write": "node scripts/csp.mjs --write out out-assistant",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../docs/contracts/pi-api.openapi.json -o lib/api/schema.gen.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- lib/api/schema.gen.ts"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/app-check": "0.13.1",
    "@firebase/auth": "1.13.6",
    "@firebase/functions": "0.14.0",
    "@tanstack/react-query": "5.104.0",
    "echarts": "6.1.0",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
