# Copy to .env.productintelligence-beeb3 (gitignored) for `firebase deploy --config
# apps/assistant/firebase.json`. Values are filled in by the owner at deploy time (design §9.4
# step 4); never commit them. The password is not here: it is the Secret Manager secret
# KILL_SWITCH_PASSWORD, bound to budgetKillSwitch only. A missing or malformed value makes the
# function refuse to start.

# budgetKillSwitch
# The budget's UUID in lower case, as in the alert's budgetId attribute (e.g. from
# `gcloud billing budgets list`, the last path segment of the name).
KILL_SWITCH_BUDGET_ID=
# ISO 4217 code in capitals, as the owner verifies it at §9.4 step 1. Never guessed.
KILL_SWITCH_CURRENCY=
KILL_SWITCH_API_KEY=
KILL_SWITCH_EMAIL=

# assistantChat (later stage; not needed to deploy the kill switch)
PI_API_BASE_URL=
PI_VERTEX_LOCATION=
PI_EVIDENCE_HOSTS=
