# Copy to .env (git-ignored) and adjust. Local development only — no real secrets here.

# PostgreSQL 16 + pgvector (infra/docker-compose.yml)
PI_DB_HOST=127.0.0.1
PI_DB_PORT=55432
PI_DB_USER=pi
PI_DB_PASSWORD=pi_local_only
PI_DB_NAME=pi
# SQLAlchemy/psycopg 3 URL used by Alembic and the test-suite.
PI_DATABASE_URL=postgresql+psycopg://pi:pi_local_only@127.0.0.1:55432/pi

# Firebase emulators (infra/firebase.json). A demo-* project id: the emulators never touch the cloud.
FIREBASE_PROJECT_ID=demo-productintelligence
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:59099
FIRESTORE_EMULATOR_HOST=127.0.0.1:58080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:59199
